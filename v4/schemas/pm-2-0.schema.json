{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpi-sena-factory/v4/schemas/pm-2-0.schema.json",
  "title": "PM-2.0 — RAP Session Architect (v4.0)",
  "description": "Session Blueprint: arquitectura de 8 sesiones × 60h (48 directas + 12 autónomas). Por convención canónica el blueprint se emite con 7 entradas (S1-S5 individuales, S6 split en 6_primera_mitad, S6-2ª-mitad+S7+S8 mergeados como bloque Final Mission). Consume GFPI-F-134 cols 1-5 de pm-1-2 y emite asignación de PMs + evidencias por sesión. Input obligatorio para pm-2-1..pm-2-10.",
  "type": "object",
  "required": [
    "pm_id",
    "run_id",
    "model",
    "generated_at",
    "guide",
    "status",
    "session_blueprint"
  ],
  "properties": {
    "pm_id": { "type": "string", "const": "PM-2.0" },
    "run_id": { "$ref": "common/run-id.schema.json" },
    "model": { "type": "string", "minLength": 3 },
    "generated_at": { "type": "string", "format": "date-time" },
    "guide": { "type": "string", "minLength": 3 },
    "status": {
      "type": "string",
      "enum": ["draft", "pending_review", "approved", "locked"]
    },
    "session_blueprint": {
      "type": "object",
      "required": [
        "rap_id",
        "rap_name",
        "competencia",
        "program_info",
        "total_hours",
        "direct_hours",
        "autonomous_hours",
        "sessions",
        "hours_validation",
        "bloom_progression",
        "criteria_sena_validation",
        "cuestionario_s6_preview"
      ],
      "properties": {
        "rap_id": {
          "type": "string",
          "pattern": "^[0-9]{6,12}$",
          "description": "Código SOFÍA Plus del RAP"
        },
        "rap_name": { "type": "string", "minLength": 30 },
        "competencia": { "type": "string", "minLength": 30 },
        "program_info": {
          "type": "object",
          "required": ["program_name", "program_type", "ficha", "guide", "cefr_level", "sector"],
          "properties": {
            "program_name": { "type": "string", "minLength": 5 },
            "program_type": { "type": "string", "enum": ["Técnico", "Tecnológico"] },
            "ficha": { "type": "string" },
            "guide": { "type": "string", "minLength": 3 },
            "cefr_level": { "$ref": "common/cefr-level.schema.json" },
            "sector": { "type": "string", "minLength": 3 },
            "universo_narrativo": {
              "type": "string",
              "description": "Narrativa del universo pedagógico de la guía (personajes, ambiente, escenario laboral)"
            }
          },
          "additionalProperties": false
        },
        "total_hours": { "type": "integer", "const": 60 },
        "direct_hours": { "type": "integer", "const": 48 },
        "autonomous_hours": { "type": "integer", "const": 12 },
        "hours_resolution_note": {
          "type": "string",
          "description": "Nota operativa si hubo ajuste de horas respecto a un run previo"
        },
        "sessions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 8,
          "description": "Convención canónica: 7 entradas (S1, S2, S3, S4, S5, 6_primera_mitad, 6_segunda_mitad_7_8). Opción excepcional: 8 entradas si S6b/S7/S8 se separan.",
          "items": {
            "type": "object",
            "required": [
              "session",
              "title",
              "fase_sena",
              "momento_sena",
              "direct_hours",
              "autonomous_hours",
              "pms_active",
              "technical_focus",
              "language_focus",
              "transversal_rap",
              "transversal_justification",
              "bloom_level",
              "generates_evidence",
              "autonomous_work"
            ],
            "properties": {
              "session": {
                "description": "Identificador de sesión: entero 1-8 o string canónico ('6_primera_mitad', '6_segunda_mitad_7_8')",
                "oneOf": [
                  { "type": "integer", "minimum": 1, "maximum": 8 },
                  {
                    "type": "string",
                    "enum": ["6_primera_mitad", "6_segunda_mitad_7_8", "7", "8"]
                  }
                ]
              },
              "title": { "type": "string", "minLength": 5 },
              "fase_sena": {
                "type": "string",
                "minLength": 10,
                "description": "Descripción compuesta de la fase pedagógica (p.ej. 'Apropiación — Input Receptivo (Vocabulary + Reading)'). La fase canónica enum vive en momento_sena."
              },
              "momento_sena": {
                "type": "string",
                "enum": ["3.1", "3.2", "3.3", "3.4"],
                "description": "Código SENA del momento: 3.1 Reflexión Inicial, 3.2 Contextualización/Apropiación, 3.3 Evaluación, 3.4 Transferencia"
              },
              "direct_hours": {
                "type": "number",
                "minimum": 1.5,
                "maximum": 15,
                "description": "Horas directas de la sesión (permite decimales para medias horas)"
              },
              "autonomous_hours": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 6,
                "description": "Horas autónomas de la sesión"
              },
              "pms_active": {
                "type": "array",
                "items": { "type": "string", "minLength": 4 },
                "minItems": 1,
                "description": "PMs que se ejecutan en la sesión. Acepta códigos (PM-2.3) o descripciones cualificadas (Cuestionario Consolidado S6 — PM-4.2)."
              },
              "technical_focus": { "type": "string", "minLength": 30 },
              "language_focus": { "type": "string", "minLength": 30 },
              "transversal_rap": { "type": "string", "minLength": 10 },
              "transversal_justification": { "type": "string", "minLength": 50 },
              "bloom_level": {
                "type": "string",
                "pattern": "^L[1-6](-L[1-6])?.*$",
                "description": "Rango Bloom de la sesión (ej. 'L2-L3 (Comprender, Aplicar)'). Activity-level usa el enum canónico bloom-level.schema.json."
              },
              "generates_evidence": { "type": "boolean" },
              "evidences": {
                "type": "array",
                "description": "Evidencias de la sesión. numero:null para entradas 'Aporte Quiz S6' que alimentan E6 sin ser standalone.",
                "items": {
                  "type": "object",
                  "required": ["numero", "tipo", "instrumento", "descripcion"],
                  "properties": {
                    "numero": {
                      "oneOf": [
                        { "type": "integer", "minimum": 1, "maximum": 6 },
                        { "type": "null" }
                      ],
                      "description": "1-6 para evidencias formales E1-E6; null para aportes al cuestionario consolidado"
                    },
                    "tipo": {
                      "type": "string",
                      "enum": ["Conocimiento", "Producto", "Desempeño", "Aporte Quiz S6"]
                    },
                    "instrumento": { "type": "string", "minLength": 10 },
                    "descripcion": { "type": "string", "minLength": 20 }
                  },
                  "additionalProperties": false
                }
              },
              "evidence_note": {
                "type": "string",
                "description": "Nota cuando generates_evidence:false y hay que explicar por qué (ej. Transferencia no formal)"
              },
              "autonomous_work": {
                "type": "object",
                "required": ["duracion_h", "actividades"],
                "properties": {
                  "duracion_h": { "type": "number", "minimum": 0.5, "maximum": 6 },
                  "actividades": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 20 },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "allOf": [
              {
                "if": { "properties": { "generates_evidence": { "const": true } } },
                "then": { "required": ["evidences"] }
              }
            ],
            "additionalProperties": false
          }
        },
        "hours_validation": {
          "type": "object",
          "required": ["direct_hours", "autonomous_hours", "total_hours"],
          "properties": {
            "direct_hours": {
              "type": "object",
              "required": ["expected", "formula", "sum", "status"],
              "properties": {
                "expected": { "type": "integer", "const": 48 },
                "formula": { "type": "string" },
                "sum": { "type": "number" },
                "status": { "type": "string" }
              }
            },
            "autonomous_hours": {
              "type": "object",
              "required": ["expected", "formula", "sum", "status"],
              "properties": {
                "expected": { "type": "integer", "const": 12 },
                "formula": { "type": "string" },
                "sum": { "type": "number" },
                "status": { "type": "string" }
              }
            },
            "total_hours": {
              "type": "object",
              "required": ["expected", "sum", "status"],
              "properties": {
                "expected": { "type": "integer", "const": 60 },
                "sum": { "type": "number" },
                "status": { "type": "string" }
              }
            },
            "fix_note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "bloom_progression": {
          "type": "object",
          "description": "Progresión Bloom declarada por sesión. Keys S1..S8, S6_1st, S6-8 etc.",
          "additionalProperties": { "type": "string" }
        },
        "criteria_sena_validation": {
          "type": "object",
          "required": [
            "continuidad_integralidad",
            "antecedente_consecuente",
            "economia",
            "evidencias_alineadas"
          ],
          "properties": {
            "continuidad_integralidad": { "type": "string", "minLength": 20 },
            "antecedente_consecuente": { "type": "string", "minLength": 20 },
            "economia": { "type": "string", "minLength": 20 },
            "evidencias_alineadas": { "type": "string", "minLength": 20 }
          },
          "additionalProperties": false
        },
        "cuestionario_s6_preview": {
          "type": "object",
          "required": ["session", "total_points", "total_items", "skills"],
          "properties": {
            "session": {
              "oneOf": [
                { "type": "integer", "const": 6 },
                { "type": "string", "const": "6_primera_mitad" }
              ]
            },
            "total_points": { "type": "integer", "const": 25 },
            "total_items": { "type": "integer", "const": 25 },
            "skills": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["skill", "source_pm", "source_session", "points", "items", "source_text"],
                "properties": {
                  "skill": {
                    "type": "string",
                    "enum": ["Reading", "Vocabulary", "Grammar", "Listening", "Language Functions"]
                  },
                  "source_pm": {
                    "type": "string",
                    "pattern": "^PM-[0-9]+(\\.[0-9]+)?$"
                  },
                  "source_session": { "type": "integer", "minimum": 2, "maximum": 5 },
                  "points": { "type": "integer", "const": 5 },
                  "items": { "type": "integer", "const": 5 },
                  "source_text": { "type": "string", "minLength": 20 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
