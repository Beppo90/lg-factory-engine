{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpi-sena-factory/v4/schemas/pm-0-context.schema.json",
  "title": "PM-0 Context · CEFR Framework + Pedagogical Foundation per Run",
  "description": "Schema canónico v3.4 (2026-05-05) para output pm-0-context.json producido por PM-0. Reemplaza schema legacy v4.0 spike 2026-04-22 (preservado como .legacy-v4-spike-pre-paradigm). Refleja paradigm shift v3.0 simplificación + REGLA 11 anti-prescriptive (v3.1) + REGLA 12 traceability `_anclaje_matriz` (v3.2) + REGLA 13 multi-comp v2.0 (v3.3) + REGLA 13.5/13.6 + Anexo C INFRATI G3 (v3.3.1) + REGLA 14 mid-program awareness + Anexo D INFRATI G2 (v3.4). Incluye 4 conditional schemas: multi-comp + multi-guía + CIERRE PROGRAMA + mid-program. Validable contra runtime IMARPOR-CC-V2 + INFRATI G2/G3 + RECREACION G2. Coordinado con CC F2.8 schema drift CI Hito 4.",
  "type": "object",
  "required": [
    "schema_version",
    "pm_id",
    "pm_name",
    "pm_version",
    "run_id",
    "generated_date",
    "instructor",
    "_matriz_alineada_ref",
    "programa",
    "universo_narrativo",
    "cefr_subnivel_objetivo",
    "principios_pedagogicos_aplicables",
    "evidencias_formales_traceability",
    "validation_checks",
    "downstream_consumers",
    "_audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["v3.3.1", "v3.4"],
      "description": "Versión schema canon · debe matches PM-0 master prompt version. v3.4 introduce REGLA 14 mid-program awareness · v3.3.1 mantenido por backward compat 1 release. Bumpea cuando master cambia."
    },
    "pm_id": {
      "type": "string",
      "const": "PM-0"
    },
    "pm_name": {
      "type": "string",
      "minLength": 10,
      "description": "CEFR Framework + Pedagogical Foundation [+ sector específico]"
    },
    "pm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Semver · ej. 3.3.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Z]+-?[A-Z]*-?[0-9]{4}-[0-9]{2}-[0-9]{2}(-V[0-9]+)?$",
      "description": "Formato: PROGRAM[-SUBTYPE]-YYYY-MM-DD[-V<n>] (ej. IMARPOR-CC-2026-04-30-V2 · INFRATI-2026-05-04 · RECREACION-IMDER-2026-05-04)"
    },
    "generated_date": {
      "type": "string",
      "format": "date"
    },
    "instructor": {
      "type": "object",
      "required": ["nombre"],
      "properties": {
        "nombre": { "type": "string", "minLength": 3 },
        "rol": { "type": "string" },
        "contacto": { "type": "string" }
      }
    },

    "_matriz_alineada_ref": {
      "type": "object",
      "description": "Referencia obligatoria a pm-0-0-matriz-alineada.json upstream · NO duplica matriz · solo referencia",
      "required": ["file", "version"],
      "properties": {
        "file": { "type": "string", "pattern": "^.*pm-0-0-matriz-alineada.*\\.json$" },
        "version": { "type": "string", "description": "Versión schema matriz upstream (ej. v2.3 paradigm shift)" },
        "raps_count": { "type": "integer", "minimum": 1 },
        "criterios_canon_anchor": { "type": "array", "items": { "type": "string", "pattern": "^C0[1-8]$" }, "uniqueItems": true }
      }
    },

    "programa": {
      "type": "object",
      "required": ["denominacion", "sector", "tipo", "rango_cefr"],
      "properties": {
        "denominacion": { "type": "string", "minLength": 5 },
        "sector": { "type": "string", "description": "Sector económico (ej. TIC · marítimo · recreativo · agroindustrial)" },
        "tipo": {
          "type": "string",
          "enum": ["Técnico", "Tecnológico", "Curso Especial", "Curso Complementario"]
        },
        "ficha": { "type": "string", "pattern": "^[0-9]{6,8}$" },
        "rango_cefr": { "type": "string", "pattern": "^(A1\\.[1-3]|A2\\.[0-2]|B1\\.[0-2])(\\s*[—-]\\s*(A1\\.[1-3]|A2\\.[0-2]|B1\\.[0-2]))?$" },
        "total_guias": { "type": "integer", "minimum": 1 },
        "regla_bloques": {
          "type": "string",
          "enum": ["alineacion_1a1", "absorcion_Na1", "desdoblamiento_1aN", "alineacion_NaM"]
        },
        "ambiente_productivo": { "type": "string" }
      }
    },

    "universo_narrativo": {
      "type": "object",
      "description": "Universo narrativo sector-coherente · personajes funcionales (NO nombres reales) · escenarios + realia técnica · evita copia-fantasma cross-program",
      "required": ["personajes"],
      "properties": {
        "ambiente_principal": { "type": "string" },
        "escenarios": {
          "type": "array",
          "items": { "type": "string" }
        },
        "personajes": {
          "type": "array",
          "minItems": 2,
          "description": "Personajes funcionales · roles (NO nombres propios) · cada uno DEBE tener _anclaje_matriz (REGLA 12)",
          "items": {
            "type": "object",
            "required": ["nombre", "rol", "_anclaje_matriz"],
            "properties": {
              "nombre": { "type": "string", "minLength": 3, "description": "Rol funcional (ej. 'Ingeniero senior de proyecto') · NO nombres propios" },
              "rol": { "type": "string", "minLength": 10 },
              "edad": { "type": "string" },
              "_anclaje_matriz": {
                "type": "object",
                "description": "REGLA 12 traceability · obligatoria · cada personaje ancla a saberes/criterios canon de matriz upstream",
                "required": ["raps_que_atraviesa"],
                "properties": {
                  "saberes_que_modela": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^RA[0-9]+\\.(SC|SP)\\.[0-9]+.*$" }
                  },
                  "criterios_especificos_que_evalúa": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^C0[1-8]$" }
                  },
                  "raps_que_atraviesa": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^RA[0-9]+$" },
                    "minItems": 1
                  },
                  "competencias_tecnicas": {
                    "type": "array",
                    "description": "NEW v3.3.1 · array códigos competencias técnicas que el personaje opera · OBLIGATORIO cuando _competencias_tecnicas_modo === 'multi-comp'",
                    "items": { "type": "string", "pattern": "^[0-9]{9}$" }
                  }
                }
              }
            }
          }
        },
        "vocabulario_sector": {
          "type": "array",
          "items": { "type": "string" }
        },
        "iconografia_tone": { "type": "string" },
        "imagery_guidance_sector": { "type": "string" },
        "cultural_realia": { "type": "string" }
      }
    },

    "cefr_subnivel_objetivo": {
      "type": "string",
      "enum": ["A1.1", "A1.2", "A1.3", "A2.0", "A2.1", "A2.2", "B1.0", "B1.1", "B1.2"],
      "description": "CEFR target SOLO para esta guía · LLM elige basándose en RAP target · NO los 6 subniveles"
    },

    "principios_pedagogicos_aplicables": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "description": "5 principios maestros REGLA 2 v3.0 (NO 13 prescriptive · simplificación post-paradigm shift). Items pueden ser: principios todos · selectivo · combinación · documentado. Cada item requiere _anclaje_matriz (REGLA 12).",
      "items": {
        "type": "object",
        "required": ["principio", "aplicacion", "_anclaje_matriz"],
        "properties": {
          "principio": {
            "type": "string",
            "description": "Uno de los 5 principios maestros · Contenido técnico primario · Progresión CEFR diferenciada · L1 decrece progresivamente · Feedback diferenciado accuracy↔fluency · Evidencia alineada al criterio"
          },
          "aplicacion": { "type": "string", "minLength": 50, "description": "Cómo aplica al programa específico de este run · NO genérico" },
          "_anclaje_matriz": {
            "type": "object",
            "properties": {
              "cefr_progresion_canon": { "type": "string" },
              "evidencias_anchor": { "type": "array", "items": { "type": "string" } },
              "saberes_progresion": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },

    "final_mission": {
      "type": "object",
      "description": "Mission scenario capstone (S6½-S8 ABP) · obligatorio para Curso Especial/Complementario · opcional para Técnico/Tecnológico (que tienen proyecto_formativo)",
      "required": ["scenario", "_anclaje_matriz"],
      "properties": {
        "scenario": { "type": "string", "minLength": 80 },
        "panel_evaluador": { "type": "array", "items": { "type": "string" } },
        "sub_fases_abp": {
          "type": "array",
          "items": { "type": "object" }
        },
        "_anclaje_matriz": {
          "type": "object",
          "required": ["evidencia_capstone"],
          "properties": {
            "criterios_específicos_evaluados": {
              "type": "array",
              "items": { "type": "string", "pattern": "^C0[1-8]$" }
            },
            "saberes_movilizados": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidencia_capstone": { "type": "string", "const": "E-Misión" },
            "cierre_programa": {
              "type": "boolean",
              "description": "NEW v3.3.1 · flag CIERRE PROGRAMA activado cuando matriz upstream tiene es_ultima_guia=true · OBLIGATORIO si CIERRE"
            },
            "cobertura_acumulada_g1_g2_g3_referencia": {
              "type": "string",
              "description": "NEW v3.3.1 · path o referencia a _cobertura_total_programa upstream · NO duplicación"
            },
            "competencias_tecnicas_integradas": {
              "type": "array",
              "description": "NEW v3.3.1 · array códigos competencias integradas en capstone · OBLIGATORIO cuando multi-comp + CIERRE",
              "items": { "type": "string", "pattern": "^[0-9]{9}$" }
            }
          }
        }
      }
    },

    "grammar_focus_per_session": {
      "type": "object",
      "description": "Mapeo per sesión (S1-S8 típicamente · más para tecnológicos) de estructuras gramaticales activadas. NO 17 grupos hardcoded (REGLA 3 v3.0 anti-prescriptive). Cada estructura requiere _anclaje_matriz.",
      "patternProperties": {
        "^S[0-9]+$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["estructura", "_anclaje_matriz"],
            "properties": {
              "estructura": { "type": "string", "minLength": 10 },
              "_anclaje_matriz": {
                "type": "object",
                "required": ["rap_target", "cefr_subnivel"],
                "properties": {
                  "rap_target": { "type": "string", "pattern": "^RA[0-9]+$" },
                  "criterio_que_demanda": { "type": "string", "pattern": "^C0[1-8]$" },
                  "cefr_subnivel": { "type": "string" },
                  "competencias_tecnicas": {
                    "type": "array",
                    "description": "NEW v3.3.1 · OPCIONAL cuando multi-comp · array códigos comps que la estructura instrumentaliza",
                    "items": { "type": "string", "pattern": "^[0-9]{9}$" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "l1_policy_per_session": {
      "type": "object",
      "description": "L1 (español) policy progresiva · ~30% S1 → 0% sesiones finales · NO hardcoded por sesión (REGLA 2 P3 v3.0)",
      "patternProperties": {
        "^S[0-9]+(-S[0-9]+)?$": {
          "type": "object",
          "required": ["porcentaje", "_anclaje_matriz"],
          "properties": {
            "porcentaje": { "type": "string", "pattern": "^[0-9]+%$" },
            "rationale": { "type": "string" },
            "_anclaje_matriz": {
              "type": "object",
              "properties": {
                "evidencias_anchor": { "type": "array", "items": { "type": "string" } },
                "criterios_especificos": { "type": "array", "items": { "type": "string", "pattern": "^C0[1-8]$" } },
                "competencias_tecnicas_scaffold": {
                  "type": "object",
                  "description": "NEW v3.3.1 · OPCIONAL cuando multi-comp · mapping competencia → descripción scaffold (alto/medio/bajo)",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },

    "evidencias_formales_traceability": {
      "type": "object",
      "description": "Mapping completo Sesión → Evidencia → Criterio → RAP → Instrumento (REGLA 12 v3.2). Cubre E1-E6 + E-Misión. Cada item tiene 4 fields obligatorios.",
      "minProperties": 6,
      "patternProperties": {
        "^E[1-6](_S[0-9]+)?_[A-Za-z]+$|^EMision_S[0-9]+_[A-Za-z]+$|^E[1-6]parcial_S[0-9]+_[A-Za-z]+$|^E[1-6]final_S[0-9]+_[A-Za-z]+$": {
          "type": "object",
          "required": ["criterio_especifico", "rap", "instrumento"],
          "properties": {
            "criterio_especifico": { "type": "string", "pattern": "^C0[1-8]$" },
            "rap": {
              "oneOf": [
                { "type": "string", "pattern": "^RA[0-9]+$" },
                { "type": "array", "items": { "type": "string", "pattern": "^RA[0-9]+$" } }
              ]
            },
            "instrumento": { "type": "string", "minLength": 5 }
          }
        }
      }
    },

    "_competencias_tecnicas_modo": {
      "type": "string",
      "enum": ["single-comp-legacy", "single-comp-v2.0", "multi-comp"],
      "description": "NEW v3.3.1 · REGLA 13.1 · modo detectado del schema input matriz upstream"
    },

    "_n_competencias_tecnicas": {
      "type": "integer",
      "minimum": 1,
      "description": "NEW v3.3.1 · número de competencias técnicas anclaje"
    },

    "_competencias_tecnicas_codigos": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{9}$" },
      "uniqueItems": true,
      "description": "NEW v3.3.1 · array códigos SOFÍA competencias técnicas"
    },

    "_split_strategy_heredado": {
      "type": "object",
      "description": "NEW v3.3.1 · REGLA 13.5 · heredado de programa_metadata.split_strategy upstream",
      "properties": {
        "valor_canon": {
          "type": "string",
          "enum": ["A", "B"],
          "description": "A · secuencial equilibrado · B · por complejidad pedagógica"
        },
        "descripcion_completa": { "type": "string" },
        "guide_id": { "type": "string", "pattern": "^G[0-9]+$" },
        "guide_total": { "type": "integer", "minimum": 1 },
        "decision_capstone": { "type": "string" }
      }
    },

    "_position_programa": {
      "type": "object",
      "description": "NEW v3.4 · REGLA 14 mid-program awareness pedagógica estructural · OBLIGATORIO cuando programa.total_guias > 1 · convierte split_strategy.descripcion_completa string upstream en field structured · awareness saberes anteriores + posteriores + guard rails + Bloom progression",
      "required": ["guide_id", "guide_total", "k_index", "es_apertura", "es_intermedia", "es_cierre_programa", "es_unica_guia"],
      "properties": {
        "guide_id": { "type": "string", "pattern": "^G[0-9]+$" },
        "guide_total": { "type": "integer", "minimum": 1 },
        "k_index": {
          "type": "integer",
          "minimum": 1,
          "description": "Índice numérico de la guía (G2 → 2)"
        },
        "es_apertura": {
          "type": "boolean",
          "description": "k_index === 1 (primera guía del programa)"
        },
        "es_intermedia": {
          "type": "boolean",
          "description": "1 < k_index < guide_total (REGLA 14 FULL aplica)"
        },
        "es_cierre_programa": {
          "type": "boolean",
          "description": "k_index === guide_total OR es_ultima_guia (REGLA 13.3 + REGLA 14 parcial)"
        },
        "es_unica_guia": {
          "type": "boolean",
          "description": "guide_total === 1 (REGLA 14 NO aplica)"
        },
        "saberes_acumulados_g_anteriores": {
          "type": "object",
          "description": "REGLA 14.2 · OBLIGATORIO cuando es_intermedia OR es_cierre_programa · estructura per G_anterior",
          "patternProperties": {
            "^G[0-9]+$": {
              "type": "object",
              "required": ["ra_codigos_cubiertos", "_fuente"],
              "properties": {
                "ra_codigos_cubiertos": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^RA[0-9]+$" },
                  "minItems": 1
                },
                "competencias_tecnicas_activadas": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[0-9]{9}$" }
                },
                "cefr_subnivel_alcanzado": {
                  "type": "string",
                  "pattern": "^(A1\\.[1-3]|A2\\.[0-2]|B1\\.[0-2])$"
                },
                "verbo_cognitivo_dominante_split": { "type": "string", "minLength": 10 },
                "evidencias_emitidas": { "type": "array", "items": { "type": "string" } },
                "_anclaje_matriz_path": { "type": "string" },
                "_fuente": {
                  "type": "string",
                  "enum": ["runtime_matriz", "split_strategy_string", "hybrid"]
                }
              }
            }
          },
          "properties": {
            "G_anterior_más_próxima": { "type": "string", "pattern": "^G[0-9]+$" }
          }
        },
        "saberes_pendientes_g_posteriores": {
          "type": "object",
          "description": "REGLA 14.3 · OBLIGATORIO cuando es_apertura OR es_intermedia · estructura per G_posterior",
          "patternProperties": {
            "^G[0-9]+$": {
              "type": "object",
              "required": ["ra_codigos_pendientes", "_fuente"],
              "properties": {
                "ra_codigos_pendientes": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^RA[0-9]+$" }
                },
                "competencias_tecnicas_pendientes": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[0-9]{9}$" }
                },
                "cefr_subnivel_target": {
                  "type": "string",
                  "pattern": "^(A1\\.[1-3]|A2\\.[0-2]|B1\\.[0-2])$"
                },
                "verbo_cognitivo_anticipado_split": { "type": "string", "minLength": 10 },
                "es_ultima_guia": { "type": "boolean" },
                "_fuente": {
                  "type": "string",
                  "enum": ["runtime_matriz", "split_strategy_string", "hybrid"]
                }
              }
            }
          },
          "properties": {
            "G_posterior_más_próxima": { "type": "string", "pattern": "^G[0-9]+$" }
          }
        },
        "_guard_rails": {
          "type": "object",
          "description": "REGLA 14.4 · flags anti-conclusion premature · OBLIGATORIO cuando es_intermedia",
          "properties": {
            "no_concluir_capstone_aqui": { "type": "boolean" },
            "no_repetir_saberes_g_anteriores": { "type": "boolean" },
            "scope_capstone_max": { "type": "string", "minLength": 10 },
            "narrativa_abierta_para_G_posteriores": { "type": "boolean" }
          }
        },
        "_bloom_progression_recommendation": {
          "type": "object",
          "description": "REGLA 14.5 · recommendation Bloom monotónico · alimenta validation_check 9",
          "properties": {
            "g_anterior_cerro_en": { "type": "string", "pattern": "^L[0-6].*" },
            "g_actual_debe_abrir_en": { "type": "string", "pattern": "^L[0-6].*" },
            "g_actual_no_debe_retroceder_a": {
              "type": "array",
              "items": { "type": "string", "pattern": "^L[0-6]$" }
            },
            "g_posterior_anticipado_en": { "type": "string" }
          }
        },
        "_anclaje_matriz": {
          "type": "object",
          "properties": {
            "split_strategy_heredado": { "type": "string" },
            "raps_metadata_heredado": { "type": "string" },
            "fuente_inferencia": {
              "type": "string",
              "enum": ["runtime_matrices", "split_strategy_string", "hybrid"]
            }
          }
        },
        "warning": {
          "type": "object",
          "description": "Opcional · si runtime G_anteriores/posteriores no disponibles",
          "properties": {
            "g_anteriores_no_disponibles_runtime": { "type": "boolean" },
            "g_posteriores_no_disponibles_runtime": { "type": "boolean" },
            "fallback_strategy": { "type": "string" }
          }
        }
      }
    },

    "_raps_metadata": {
      "type": "object",
      "description": "NEW v3.3.1 · REGLA 13.6 · metadata RAPs subset-por-guía vs total programa · OBLIGATORIO cuando guide_total > 1",
      "required": ["raps_count_esta_guia", "guide_id"],
      "properties": {
        "raps_count_esta_guia": { "type": "integer", "minimum": 1 },
        "raps_count_total_programa": { "type": "integer", "minimum": 1 },
        "guide_id": { "type": "string", "pattern": "^G[0-9]+$" },
        "guide_total": { "type": "integer", "minimum": 1 },
        "raps_ids_esta_guia": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RA[0-9]+$" }
        },
        "raps_ids_total_programa": {
          "type": "array",
          "items": { "type": "string", "pattern": "^RA[0-9]+$" }
        }
      }
    },

    "validation_checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 9,
      "description": "Validation checks bloqueantes · 6 base v3.0 + check 7 traceability v3.2 + check 8 multi_comp_compatibility v3.3.1 + check 9 bloom_progression_monotonica v3.4",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 9 },
          "name": {
            "type": "string",
            "enum": [
              "matriz_alineada_ref_valid",
              "cefr_subnivel_canonical",
              "universo_narrativo_complete",
              "principios_aplicados",
              "no_duplication_matriz",
              "anti_copia_fantasma",
              "traceability_matriz_completa",
              "multi_comp_compatibility",
              "bloom_progression_monotonica"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "N/A"]
          },
          "evidence": { "type": "string" },
          "anclajes_detectados": { "type": "integer", "minimum": 0 },
