{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fpi-sena-factory/v4/schemas/pm-1-2.schema.json",
  "title": "PM-1.2 — Scope & Sequence — Desarrollo por Bloque (v4.3.1)",
  "description": "Canon vigente v4.3.1 (2026-05-04 cluster cascade sesión 3/4 · curación per RAP cross-comp + REGLA 18 NEW). Reemplaza schema legacy v4.0 (preservado como .legacy-v4-pre-paradigm-tripartita). Codifica REGLAS 1-9 base + REGLAS 10-17 v4.2 (scope diferenciado tipo_bloque + libertad LLM) + REGLA 18 v4.3 (curación 3 fuentes per RAP cross-comp) + heredancias multi-comp/multi-guía/CIERRE PROGRAMA desde PM-0 v3.4.1 + PM-0.0 v2.3 + PM-1.1 v2.9. Validable contra runtime IMARPOR-CC-V2 (single-comp legacy · runtime puede emitir 'APROPIACION' sin tilde · drift de fixture documentado). Coordinado con CC F2.8 schema drift CI Hito 4 (d) sub-task 2.",
  "type": "object",
  "required": [
    "pm_id",
    "pm_name",
    "pm_version",
    "run_id",
    "generated_date",
    "instructor",
    "_pm11_ref",
    "_pm00_matriz_ref",
    "_pm0_context_ref",
    "_canon_authority",
    "meta_bloque_presentacion_l1",
    "sub_bloques_tripartitos",
    "validation_checks",
    "downstream_consumers",
    "enriched"
  ],
  "properties": {
    "pm_id": { "type": "string", "const": "PM-1.2" },
    "pm_name": { "type": "string", "minLength": 5 },
    "pm_version": {
      "type": "string",
      "enum": ["4.3", "4.3.1"],
      "description": "v4.3 introduce REGLA 18 curación 3 fuentes per RAP · v4.3.1 cierra HIGH 1 audit + REGLA 18.7 evidence-before-canon · backward compat 1 release"
    },
    "pm_iteration": { "type": "string" },
    "run_id": { "type": "string" },
    "generated_date": { "type": "string" },
    "instructor": { "type": "string", "minLength": 5 },
    "_pm11_ref": { "type": "string", "description": "Trazabilidad upstream · pm-1-1.json" },
    "_pm00_matriz_ref": { "type": "string", "description": "Trazabilidad upstream · pm-0-0-matriz-alineada.json" },
    "_pm0_context_ref": { "type": "string", "description": "Trazabilidad upstream · pm-0-context.json" },
    "_pm12_input_ref": { "type": "string" },
    "_correction_applied": { "type": "string" },
    "_canon_authority": { "type": "string", "description": "Versión master prompt PM-1.2 que generó este artefacto" },
    "meta_bloque_presentacion_l1": {
      "type": "object",
      "description": "REGLA 5 v2.6 · meta-bloque encuadre L1 español pre-APERTURA · función diagnóstica + activación previos. NO produce evidencia formal.",
      "required": ["tipo", "lengua", "duracion_estimada_min", "narrativa_l1", "objetivos_l1", "encuadre_l1"],
      "properties": {
        "tipo": { "type": "string", "const": "meta_bloque_presentacion_l1" },
        "alcance": { "type": "string" },
        "lengua": { "type": "string", "const": "español (L1)" },
        "duracion_estimada_min": { "type": "integer", "minimum": 30 },
        "_aplicabilidad": { "type": "string" },
        "narrativa_l1": { "type": "string", "minLength": 50 },
        "objetivos_l1": { "type": "array", "items": { "type": "string", "minLength": 10 }, "minItems": 1 },
        "encuadre_l1": { "type": "string", "minLength": 50 },
        "_anclaje_matriz_meta_bloque": { "type": "object" }
      },
      "additionalProperties": false
    },
    "sub_bloques_tripartitos": {
      "type": "array",
      "minItems": 3,
      "description": "REGLAS 10-11 v4.2 · 1 APERTURA + N APROPIACIÓN (1 per RAP) + 1 TRANSFERENCIA. Cada sub_bloque tiene structure según tipo_bloque (discriminator).",
      "items": {
        "type": "object",
        "required": ["bloque_id", "tipo_bloque", "scope_diferenciado", "titulo", "sesiones_anchor", "horas_directas", "_anclaje_matriz_bloque"],
        "properties": {
          "bloque_id": { "type": "string", "pattern": "^B[0-9T](_[A-Z]+)?$" },
          "tipo_bloque": {
            "type": "string",
            "enum": ["APERTURA", "APROPIACIÓN", "TRANSFERENCIA"],
            "description": "Discriminator REGLA 11 v4.2 · 3 valores canon. Runtime legacy puede emitir 'APROPIACION' sin tilde · drift de fixture documentado."
          },
          "scope_diferenciado": { "type": "string", "minLength": 30 },
          "titulo": { "type": "string", "minLength": 5 },
          "sesiones_anchor": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]+$" }, "minItems": 1 },
          "horas_directas": { "type": "number", "minimum": 0 },
          "cefr_subnivel": { "type": "string", "pattern": "^(A1\\.[1-3]|A2\\.[0-2]|B1\\.[0-2])$" },
          "rap_ingles": { "type": ["string", "null"], "description": "RAP target. APROPIACIÓN: string. APERTURA + TRANSFERENCIA: null (REGLAS 18.4 + 11)" },
          "rap_target": { "type": ["string", "null"], "description": "Alias legacy v4.2 de rap_ingles" },
          "_anclaje_matriz_bloque": {
            "type": "object",
            "description": "REGLA 12 v4.2 · trazabilidad heredada matriz alineada",
            "properties": {
              "rap_target": { "type": "string" },
              "raps_que_atraviesa": { "type": "array", "items": { "type": "string" } },
              "competencias_tecnicas": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[0-9]{9}$" },
                "description": "v4.3 NEW · multi-comp heredado pm-0-context._competencias_tecnicas_modo='multi-comp'"
              },
              "competencias_tecnicas_integradas": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[0-9]{9}$" },
                "description": "Solo TRANSFERENCIA + multi-comp + CIERRE (REGLA 13.3 PM-0)"
              },
              "cierre_programa": { "type": "boolean" },
              "saberes_que_modela": { "type": "array", "items": { "type": "string" } },
              "criterios_que_evalua": { "type": "array", "items": { "type": "string" } }
            }
          },
          "curacion_3_fuentes": {
            "type": "object",
            "description": "REGLA 18.1 v4.3 · OBLIGATORIO en APROPIACIÓN. AUSENTE en APERTURA + TRANSFERENCIA (REGLA 18.4).",
            "required": ["story_a", "story_b", "dialogue"],
            "properties": {
              "story_a": { "$ref": "#/$defs/fuente_curada" },
              "story_b": { "$ref": "#/$defs/fuente_curada" },
              "dialogue": { "$ref": "#/$defs/fuente_curada" }
            }
          },
          "_produces_evidencia": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "enum": ["E1", "E2", "E3", "E4", "E5", "E6"] },
              { "type": "array", "items": { "type": "string", "enum": ["E1", "E2", "E3", "E4", "E5", "E6"] } }
            ]
          },
          "story_a_reading": { "type": "object", "description": "Legacy v4.2 · reemplazado por curacion_3_fuentes.story_a" },
          "story_b_listening": { "type": "object", "description": "Legacy v4.2 · reemplazado por curacion_3_fuentes.story_b" },
          "key_vocabulary_per_rap": { "type": "array" },
          "language_functions_per_rap": { "type": "array" },
          "grammar_items_per_rap": { "type": "array" },
          "task_writing_derivada": { "type": "object" },
          "task_consolidacion_C07_cara_RA1": { "type": "object" },
          "analisis_linguistico_cefr": { "type": "object" },
          "mission_brief": { "type": "object", "description": "Solo TRANSFERENCIA · ABP capstone" },
          "subfases_abp_context": { "type": "array" },
          "materiales_simulacion": { "type": "array" },
          "rubrica_abp_capstone": { "type": "object" },
          "materiales_spark": { "type": "array", "description": "Solo APERTURA" },
          "vocabulario_diagnostico": { "type": "array", "description": "Solo APERTURA" },
          "aprendizajes_previos_a_activar": { "type": "array", "description": "Solo APERTURA" },
          "contexto_general_raps_presentado": { "type": "string", "description": "Solo APERTURA" },
          "transversalidad_justificacion": { "type": "string", "description": "Solo APERTURA" },
          "_restriccion_canon": { "type": "string" }
        }
      }
    },
    "validation_checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "description": "v4.2: 6 checks · v4.3: +check 7 curacion_per_rap_canonica BLOQUEANTE",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 7 },
          "name": {
            "type": "string",
            "enum": [
              "pm11_ref_valid",
              "tripartita_structure_complete",
              "anclaje_matriz_complete",
              "no_duplication_pm11",
              "produces_evidencia_canon",
              "anti_copia_fantasma",
              "curacion_per_rap_canonica"
            ]
          },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "WARN", "N/A"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "_anti_drift_audit_v2": { "type": "object", "additionalProperties": true },
    "_decisiones_libertad_llm_aplicadas": { "type": "array", "items": { "type": "string" } },
    "_limites_canon_aplicados_estrictos": { "type": "array", "items": { "type": "string" } },
    "downstream_consumers": { "type": "array", "items": { "type": "string" } },
    "_audit": { "type": "object", "additionalProperties": true },
    "enriched": { "type": "boolean" },
    "_block_downstream": { "type": "boolean" },
    "_split_strategy_heredado": {
      "type": "object",
      "description": "Heredado pm-0-context · OBLIGATORIO si total_guias > 1"
    },
    "_raps_metadata": {
      "type": "object",
      "description": "Heredado pm-0-context · OBLIGATORIO si total_guias > 1"
    }
  },
  "$defs": {
    "fuente_curada": {
      "type": "object",
      "required": ["titulo", "tipo", "fuente"],
      "properties": {
        "titulo": { "type": "string", "minLength": 5 },
        "tipo": { "type": "string" },
        "fuente": { "type": "string", "minLength": 5 },
        "_anclaje_tecnico_competencia": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{9}$" },
          "minItems": 1,
          "description": "REGLA 18.2 v4.3 · OBLIGATORIO si multi-comp heredado"
        },
        "_anclaje_matriz": {
          "type": "object",
          "properties": {
            "saberes_que_modela": { "type": "array", "items": { "type": "string" } },
            "criterios_que_evalua": { "type": "array", "items": { "type": "string" } }
          }
        },
        "_produces_evidencia": { "type": "string", "enum": ["E1", "E2", "E3", "E4", "E5", "E6"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
